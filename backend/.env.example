# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://drltas:drltas_dev_password@localhost:5432/drltas_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# PDF Generation
PDF_OUTPUT_DIR=./reports

# Email (Optional - for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@drltas.com

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Error Tracking & Monitoring (Sentry)
# Get your DSN from https://sentry.io
# Optional: If not configured, error tracking will be disabled
SENTRY_DSN=

# Frontend URL (for email links, etc.)
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@drltas.com
ADMIN_PASSWORD=changeme123
